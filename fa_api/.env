# Google Apps Script 的後端連結 (備援或主要儲存)
GOOGLE_APP_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# 資料庫儲存模式 (SqlServer 或 GoogleSheet)
# 若設定為 SqlServer，則由本地端的 SSMS 建立 SQL Server 進行連線
STORAGE_MODE=SqlServer

# SQL Server 連線字串 (開發環境)
DB_CONNECTION_STRING=Server=(localdb)\MSSQLLocalDB;Database=ContosoUniversity;Trusted_Connection=True;Encrypt=False;
